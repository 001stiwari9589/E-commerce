# =============================================================================
# SMARTDEALS — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and configure your real keys.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# =============================================================================

# Server Port
PORT=5000

# MongoDB Database Connection String (Local or MongoDB Atlas Cloud)
# Example: mongodb://127.0.0.1:27017/stmart
# Or Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/stmart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stmart

# Secret Salt for Cryptographic OTP Hashing
OTP_SECRET=smartdeals_otp_salt_secret_9589

# =============================================================================
# EMAIL SERVICE CONFIGURATION (BREVO OR RESEND)
# Choose one of the following providers to deliver real 6-digit OTPs to Gmail:
# =============================================================================

# Provider Selection: "resend" | "brevo" | "smtp"
EMAIL_PROVIDER=resend

# --- OPTION A: RESEND (Recommended - 1-minute free setup, 3,000 free emails/month) ---
# 1. Sign up for free at https://resend.com
# 2. Go to "API Keys" -> Create API Key -> Copy key (starts with "re_...")
# 3. Paste below:
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=SmartDeals <onboarding@resend.dev>

# --- OPTION B: BREVO (Formerly Sendinblue - 300 free emails/day) ---
# 1. Sign up for free at https://brevo.com
# 2. Go to Account -> "SMTP & API" -> Generate a new API Key (starts with "xkeysib-...")
# 3. Paste below:
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@gmail.com
BREVO_SENDER_NAME=SmartDeals.in Security

# --- OPTION C: CUSTOM SMTP / GMAIL APP PASSWORD ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Admin Access Security Secret
ADMIN_SECRET=your_strong_admin_secret_here

# Verified Amazon Associates Tag
AMAZON_ASSOCIATE_TAG=stmart05-21

# Twilio WhatsApp Integration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
OWNER_WHATSAPP=whatsapp:+919589018011
