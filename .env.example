# =============================================================================
# ST MART — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# =============================================================================

# Server Port
PORT=5000

# MongoDB Database Connection String (Use local or MongoDB Atlas)
# Example: mongodb://127.0.0.1:27017/stmart
# Or Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/stmart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stmart

# Admin Access Security Secret (Set a strong secret for admin panel access)
ADMIN_SECRET=your_strong_admin_secret_here

# Verified Amazon Associates Tag
AMAZON_ASSOCIATE_TAG=stmart05-21

# Email Notification SMTP Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Twilio WhatsApp Integration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+919876543210
